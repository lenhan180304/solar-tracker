# Sao chép thành biến môi trường trên Render (KHÔNG commit file .env thật)
PORT=8080
# Chuỗi ngẫu nhiên >= 32 ký tự, ví dụ: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=
SESSION_HOURS=8
# Broker MQTT (HiveMQ Cloud Serverless – miễn phí). Tài khoản RIÊNG cho Backend, khác tài khoản của ESP32.
MQTT_URL=mqtts://xxxxxxxx.s1.eu.hivemq.cloud:8883
MQTT_USER=backend
MQTT_PASS=
# Danh sách thiết bị: id:tên, cách nhau bởi dấu phẩy (id phải trùng Device ID nhập trên ESP32)
DEVICES=tracker01:Solar Tracker 01
# PostgreSQL miễn phí (Neon). Bỏ trống = lưu tạm trong RAM (mất khi khởi động lại).
DATABASE_URL=postgresql://user:pass@ep-xxx.aws.neon.tech/neondb?sslmode=require
RETENTION_DAYS=7
# Tài khoản admin đầu tiên (chỉ tạo khi chưa có admin nào). Đổi/xoá biến sau khi đăng nhập lần đầu.
ADMIN_USER=admin
ADMIN_PASS=
# Chỉ đặt false khi chạy thử bằng http://localhost
COOKIE_SECURE=true
